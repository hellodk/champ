#!/usr/bin/env bash
# scripts/champ — unified CLI for the Champ VS Code extension
# Usage:
#   scripts/champ                         # interactive menu
#   scripts/champ build                   # compile + package VSIX
#   scripts/champ install                 # install latest GitHub release
#   scripts/champ install build           # build current checkout + install
#   scripts/champ release                 # push master; workflow publishes release
#   scripts/champ watch                   # dev watch (extension + webview)
#   scripts/champ test [unit|int|e2e|all] # run tests
#   scripts/champ test report             # print test report summary
#   scripts/champ lint                    # eslint + type-check
#   scripts/champ version                 # print current version
#   scripts/champ version next [cur] [tag] # compute the next version from conventional commits
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT"

# ── helpers ──────────────────────────────────────────────────────────────────

_version() {
  node -e "process.stdout.write(require('./package.json').version)"
}

# Next version from conventional commits, taking the greater of the current
# version and the latest release tag as the base. `feat:` bumps minor, a
# breaking change bumps major, everything else bumps patch. Used by the
# release workflow before it bumps package.json (the single version source for
# both the extension and the headless CLI).
_next_version() {
  local current="${1:-$(_version)}"
  local latest_tag="${2:-}"
  local commits="${3:-${CHAMP_VERSION_COMMITS:-}}"
  node - "$current" "$latest_tag" "$commits" <<'NODE'
const [, , currentRaw, latestTagRaw, commitsRaw] = process.argv;
try {
  const parse = (raw, label) => {
    const match = /^v?(\d+)\.(\d+)\.(\d+)$/.exec(String(raw ?? "").trim());
    if (!match) throw new Error(`invalid ${label}: ${raw}`);
    return {
      major: Number(match[1]),
      minor: Number(match[2]),
      patch: Number(match[3]),
    };
  };
  const compare = (a, b) =>
    a.major - b.major || a.minor - b.minor || a.patch - b.patch;
  const current = parse(currentRaw, "current version");
  const latest =
    String(latestTagRaw ?? "").trim() === ""
      ? { major: 0, minor: 0, patch: 0 }
      : parse(latestTagRaw, "latest tag");
  const base = compare(current, latest) >= 0 ? current : latest;
  const subjects = String(commitsRaw ?? "")
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean);
  const breaking = subjects.some(
    (line) => /BREAKING CHANGE:/.test(line) || /^\w+(\([^)]*\))?!:/.test(line),
  );
  const feature = subjects.some((line) => /^feat(\([^)]*\))?(!)?: /.test(line));
  const next = breaking
    ? { major: base.major + 1, minor: 0, patch: 0 }
    : feature
      ? { major: base.major, minor: base.minor + 1, patch: 0 }
      : { major: base.major, minor: base.minor, patch: base.patch + 1 };
  process.stdout.write(`${next.major}.${next.minor}.${next.patch}\n`);
} catch (err) {
  process.stderr.write(`champ: ${err instanceof Error ? err.message : err}\n`);
  process.exit(1);
}
NODE
}

_require_cmds() {
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || { echo "ERROR: '$cmd' not found in PATH" >&2; exit 1; }
  done
}

# Resolve the package-manager command once per process. Corepack ships with
# Node, so a machine without a globally linked `pnpm` binary still works.
PNPM_CMD=()
_resolve_pnpm() {
  if (( ${#PNPM_CMD[@]} > 0 )); then
    return 0
  fi
  if command -v pnpm >/dev/null 2>&1; then
    PNPM_CMD=(pnpm)
  elif command -v corepack >/dev/null 2>&1; then
    PNPM_CMD=(corepack pnpm)
  else
    echo "ERROR: 'pnpm' not found in PATH and 'corepack' is unavailable. Run 'corepack enable' or install pnpm." >&2
    exit 1
  fi
}

_require_pnpm() { _resolve_pnpm; }

_pnpm() {
  _resolve_pnpm
  "${PNPM_CMD[@]}" "$@"
}

# Latest release tag via the GitHub API (gh → jq). `gh` is authenticated in
# this environment; fall back so it also works where gh is unauthenticated.
_latest_version() {
  gh api repos/hellodk/champ/releases/latest -q .tag_name 2>/dev/null \
    || jq -r .tag_name <(curl -fsSL https://api.github.com/repos/hellodk/champ/releases/latest)
}

# Run `code` without the DEP0169 url.parse() deprecation spam that VS Code's
# own CLI emits when install output passes through it.
_code() {
  NODE_OPTIONS=--no-deprecation code "$@"
}

_section() { echo ""; echo "── $* ──────────────────────────────────────"; }
_ok()      { echo "  ✓ $*"; }

# ── commands ─────────────────────────────────────────────────────────────────

cmd_version() {
  if [[ "${1:-}" == "next" ]]; then
    shift
    _next_version "${1:-$(_version)}" "${2:-}" "${3:-}"
    return
  fi
  echo "champ $(_version)"
}

cmd_build() {
  _require_cmds node
  _require_pnpm
  _section "compile"
  _pnpm run compile
  _section "package VSIX"
  local ver
  ver=$(_version)
  _pnpm dlx @vscode/vsce package --no-dependencies 2>&1
  _ok "champ-${ver}.vsix ready"
}

cmd_install() {
  local mode="${1:-latest}"
  _require_cmds code

  local ver vsix
  if [[ "$mode" == "build" ]]; then
    _require_cmds node
    _require_pnpm
    _section "build from source"
    cmd_build
    ver=$(_version)
    vsix="${ROOT}/champ-${ver}.vsix"
    _ok "installing local build ${vsix##*/}"
  else
    _require_cmds curl jq gh
    ver=$(_latest_version)
    vsix="${ver}-champ.vsix"
    local asset_url asset_name
    asset_url=$(gh release view "$ver" --json assets -q '.assets[0].url' 2>/dev/null \
      || curl -fsSL "https://api.github.com/repos/hellodk/champ/releases/latest" | jq -r '.assets[0].browser_download_url')
    asset_name=$(basename "$asset_url")
    _section "download ${asset_name} (${ver})"
    curl -fL "$asset_url" -o "/tmp/${vsix}"
    vsix="/tmp/${vsix}"
    _ok "installing ${asset_name}"
  fi

  _code --install-extension "$vsix" --force
  rm -f "/tmp/${ver}-champ.vsix"
  _ok "installed champ ${ver}"
}

cmd_release() {
  _require_cmds git node
  local ver latest_tag next
  ver=$(_version)
  latest_tag=$(git tag --list 'v[0-9]*' --sort=-v:refname 2>/dev/null | head -n 1 || true)
  local commits
  if [[ -n "$latest_tag" ]]; then
    commits=$(git log "${latest_tag}..HEAD" --pretty=format:%s)
  else
    commits=$(git log --pretty=format:%s)
  fi
  next=$(_next_version "$ver" "$latest_tag" "$commits")

  _section "push to GitHub"
  git push github master
  _ok "master pushed"
  _ok "Release workflow will publish v${next} with the VSIX attached"
}

cmd_watch() {
  _require_cmds node
  _require_pnpm
  _section "watch (extension + webview)"
  echo "  Ctrl-C to stop"
  _pnpm run watch
}

cmd_test() {
  _require_pnpm
  local suite="${1:-unit}"
  case "$suite" in
    unit)
      _section "unit tests"
      _pnpm exec vitest run --config vitest.config.ts --coverage
      ;;
    int|integration)
      _section "integration tests"
      _pnpm exec vitest run --config vitest.integration.config.ts
      ;;
    e2e)
      _section "E2E tests"
      _pnpm exec vitest run --config vitest.e2e.config.ts
      ;;
    report)
      cmd_test_report
      ;;
    all)
      _section "unit tests"
      _pnpm exec vitest run --config vitest.config.ts --coverage || true
      _section "integration tests"
      _pnpm exec vitest run --config vitest.integration.config.ts || true
      ;;
    *)
      echo "Usage: champ test [unit|int|e2e|all|report]" >&2
      exit 1
      ;;
  esac
}

cmd_test_report() {
  local dir="${ROOT}/test-reports"
  if [[ ! -d "$dir" ]]; then
    echo "No test-reports/ directory — run tests first." >&2
    exit 1
  fi

  echo ""
  printf "%-40s  %-8s  %-8s  %s\n" "Suite" "Passed" "Failed" "Skipped"
  printf "%-40s  %-8s  %-8s  %s\n" "─────────────────────────────────────" "──────" "──────" "───────"

  # JUnit XML is the canonical machine-readable result for every suite.
  _junit_row() {
    local label="$1" file="$2" counts total failed skipped passed
    if [[ ! -f "$file" ]]; then
      printf "%-40s  %-8s  %-8s  %s\n" "$label" "-" "-" "-"
      return
    fi
    counts=$(node -e '
      const fs = require("fs");
      const xml = fs.readFileSync(process.argv[1], "utf8");
      const attr = (tag, key) => {
        const match = new RegExp(key + "=\"(\\d+)\"").exec(tag);
        return match ? Number(match[1]) : 0;
      };
      const root = /<testsuites\b[^>]*>/.exec(xml)?.[0] ?? "";
      const total = attr(root, "tests");
      const failed = attr(root, "failures") + attr(root, "errors");
      const suites = [...xml.matchAll(/<testsuite\b[^>]*>/g)].map((m) => m[0]);
      const skipped = suites.reduce((sum, tag) => sum + attr(tag, "skipped"), 0);
      process.stdout.write([total, failed, skipped].join(" "));
    ' "$file")
    read -r total failed skipped <<< "$counts"
    passed=$((total - failed - skipped))
    printf "%-40s  %-8s  %-8s  %s\n" "$label" "$passed" "$failed" "$skipped"
  }

  _junit_row "unit" "$dir/unit/results.xml"
  _junit_row "integration" "$dir/integration/results.xml"

  local e2e="$dir/e2e/results.json"
  if [[ -f "$e2e" ]]; then
    local epassed efailed eskipped
    epassed=$(node -e "const r=require('$e2e'); process.stdout.write(String(r.numPassedTests??0))")
    efailed=$(node -e "const r=require('$e2e'); process.stdout.write(String(r.numFailedTests??0))")
    eskipped=$(node -e "const r=require('$e2e'); process.stdout.write(String(r.numPendingTests??0))")
    printf "%-40s  %-8s  %-8s  %s\n" "e2e" "$epassed" "$efailed" "$eskipped"
  else
    printf "%-40s  %-8s  %-8s  %s\n" "e2e" "-" "-" "-"
  fi

  if [[ -f "$dir/eval/retrieval.json" ]]; then
    local baseline hybrid delta
    baseline=$(node -e "const r=require('$dir/eval/retrieval.json'); process.stdout.write(r.baselineRecallAt3.toFixed(3))" 2>/dev/null || echo "?")
    hybrid=$(node -e "const r=require('$dir/eval/retrieval.json'); process.stdout.write(r.hybridRecallAt3.toFixed(3))" 2>/dev/null || echo "?")
    delta=$(node -e "const r=require('$dir/eval/retrieval.json'); process.stdout.write(r.delta.toFixed(3))" 2>/dev/null || echo "?")
    echo ""
    echo "Retrieval eval (recall@3): baseline=$baseline hybrid=$hybrid delta=$delta"
  fi

  echo ""
  if [[ -f "$dir/typecheck.txt" ]]; then
    local errs
    errs=$(wc -l < "$dir/typecheck.txt" 2>/dev/null || echo 0)
    echo "TypeScript errors: $errs (see test-reports/typecheck.txt)"
  fi
}

cmd_lint() {
  _require_pnpm
  _section "type-check"
  _pnpm run check-types
  _ok "TypeScript OK"
  _section "eslint"
  _pnpm run lint
  _ok "ESLint OK"
}

# ── interactive menu ──────────────────────────────────────────────────────────

_menu() {
  local ver
  ver=$(_version)
  echo ""
  echo "  Champ VS Code Extension — v${ver}"
  echo ""
  echo "  1) build     — compile + package VSIX"
  echo "  2) install   — install latest GitHub release"
  echo "  3) release   — push master (workflow publishes release)"
  echo "  4) watch     — dev watch mode"
  echo "  5) test      — run unit tests"
  echo "  6) test all  — unit + integration tests"
  echo "  7) report    — print test-reports/ summary"
  echo "  8) lint      — type-check + ESLint"
  echo "  9) install build — build current checkout + install"
  echo "  0) version   — print version"
  echo "  q) quit"
  echo ""
  read -rp "  Choice: " pick
  case "$pick" in
    1) cmd_build ;;
    2) cmd_install latest ;;
    3) cmd_release ;;
    4) cmd_watch ;;
    5) cmd_test unit ;;
    6) cmd_test all ;;
    7) cmd_test_report ;;
    8) cmd_lint ;;
    9) cmd_install build ;;
    0) cmd_version ;;
    q|Q) exit 0 ;;
    *) echo "  Unknown choice." >&2 ;;
  esac
}

# ── entrypoint ────────────────────────────────────────────────────────────────

if [[ $# -eq 0 ]]; then
  _menu
  exit 0
fi

case "$1" in
  build)           cmd_build ;;
  install)         shift; cmd_install "${1:-latest}" ;;
  release)         cmd_release ;;
  watch)           cmd_watch ;;
  test)            shift; cmd_test "${1:-unit}" ;;
  lint)            cmd_lint ;;
  version|-v|--version) shift; cmd_version "$@" ;;
  help|-h|--help)
    grep '^#   ' "$0" | sed 's/^# //' | head -20
    ;;
  *)
    echo "Unknown command: $1  (run 'scripts/champ help')" >&2
    exit 1
    ;;
esac
