#!/usr/bin/env bash
# scripts/champ — unified CLI for the Champ VS Code extension
# Usage:
#   scripts/champ                         # interactive menu
#   scripts/champ build                   # compile + package VSIX
#   scripts/champ install                 # install latest GitHub release
#   scripts/champ install build           # build current checkout + install
#   scripts/champ release                 # build + push + create GitHub release
#   scripts/champ watch                   # dev watch (extension + webview)
#   scripts/champ test [unit|int|e2e|all] # run tests
#   scripts/champ test report             # print test report summary
#   scripts/champ lint                    # eslint + type-check
#   scripts/champ version                 # print current version
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT"

# ── helpers ──────────────────────────────────────────────────────────────────

_version() {
  node -e "process.stdout.write(require('./package.json').version)"
}

_require_cmds() {
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || { echo "ERROR: '$cmd' not found in PATH" >&2; exit 1; }
  done
}

# Latest release tag via the GitHub API (gh → jq). `gh` is authenticated in
# this environment; fall back so it also works where gh is unauthenticated.
_latest_version() {
  gh api repos/hellodk/champ/releases/latest -q .tag_name 2>/dev/null \
    || jq -r .tag_name <(curl -fsSL https://api.github.com/repos/hellodk/champ/releases/latest)
}

# Run `code` without the DEP0169 url.parse() deprecation spam that VS Code's
# own CLI emits when install output passes through it.
_code() {
  NODE_OPTIONS=--no-deprecation code "$@"
}

_section() { echo ""; echo "── $* ──────────────────────────────────────"; }
_ok()      { echo "  ✓ $*"; }

# ── commands ─────────────────────────────────────────────────────────────────

cmd_version() {
  echo "champ $(_version)"
}

cmd_build() {
  _require_cmds node npm npx
  _section "compile"
  npm run compile
  _section "package VSIX"
  local ver
  ver=$(_version)
  npx @vscode/vsce package --no-dependencies 2>&1
  _ok "champ-${ver}.vsix ready"
}

cmd_install() {
  local mode="${1:-latest}"
  _require_cmds code

  local ver vsix
  if [[ "$mode" == "build" ]]; then
    _require_cmds node npm npx
    _section "build from source"
    cmd_build
    ver=$(_version)
    vsix="${ROOT}/champ-${ver}.vsix"
    _ok "installing local build ${vsix##*/}"
  else
    _require_cmds curl jq gh
    ver=$(_latest_version)
    vsix="${ver}-champ.vsix"
    local asset_url asset_name
    asset_url=$(gh release view "$ver" --json assets -q '.assets[0].url' 2>/dev/null \
      || curl -fsSL "https://api.github.com/repos/hellodk/champ/releases/latest" | jq -r '.assets[0].browser_download_url')
    asset_name=$(basename "$asset_url")
    _section "download ${asset_name} (${ver})"
    curl -fL "$asset_url" -o "/tmp/${vsix}"
    vsix="/tmp/${vsix}"
    _ok "installing ${asset_name}"
  fi

  _code --install-extension "$vsix" --force
  rm -f "/tmp/${ver}-champ.vsix"
  _ok "installed champ ${ver}"
}

cmd_release() {
  _require_cmds git gh node npm npx
  local ver vsix tag
  ver=$(_version)
  vsix="${ROOT}/champ-${ver}.vsix"
  tag="v${ver}"

  # Build VSIX if not already present
  if [[ ! -f "$vsix" ]]; then
    cmd_build
  else
    _section "VSIX already built"
    _ok "${vsix##*/} exists — skipping build"
  fi

  _section "push to GitHub"
  git push github master
  _ok "master pushed"

  _section "create GitHub release ${tag}"
  # Nearest reachable tag behind HEAD (never the tag being created) drives the notes range.
  local prev_tag=""
  local t d
  while read -r t; do
    [[ -z "$t" ]] && continue
    d=$(git rev-list --count "${t}..HEAD" 2>/dev/null || echo "")
    [[ "$d" == "0" ]] && continue
    prev_tag="$t"
    break
  done < <(git tag --sort=-creatordate | grep '^v')

  local notes
  if [[ -n "$prev_tag" ]]; then
    notes=$(git log "${prev_tag}..HEAD" --pretty=format:"- %s" --no-merges 2>/dev/null | head -20 || echo "- See commit history for changes")
  else
    notes=$(git log --pretty=format:"- %s" --no-merges -20 2>/dev/null || echo "- Initial release")
  fi

  gh release create "$tag" \
    "$vsix" \
    --title "Champ ${tag}" \
    --notes "$(cat <<NOTES
## Champ ${tag}

${notes}

---
Install: download \`champ-${ver}.vsix\` and run:
\`\`\`
code --install-extension champ-${ver}.vsix
\`\`\`
NOTES
)"
  _ok "release ${tag} created — $(gh release view "$tag" --json url -q .url)"
}

cmd_watch() {
  _require_cmds node npm
  _section "watch (extension + webview)"
  echo "  Ctrl-C to stop"
  npm run watch
}

cmd_test() {
  _require_cmds npx
  local suite="${1:-unit}"
  case "$suite" in
    unit)
      _section "unit tests"
      npx vitest run --config vitest.config.ts
      ;;
    int|integration)
      _section "integration tests"
      npx vitest run --config vitest.integration.config.ts
      ;;
    e2e)
      _section "E2E tests"
      npx vitest run --config vitest.e2e.config.ts
      ;;
    report)
      cmd_test_report
      ;;
    all)
      _section "unit tests"
      npx vitest run --config vitest.config.ts || true
      _section "integration tests"
      npx vitest run --config vitest.integration.config.ts || true
      ;;
    *)
      echo "Usage: champ test [unit|int|e2e|all|report]" >&2
      exit 1
      ;;
  esac
}

cmd_test_report() {
  local dir="${ROOT}/test-reports"
  if [[ ! -d "$dir" ]]; then
    echo "No test-reports/ directory — run tests first." >&2
    exit 1
  fi

  echo ""
  printf "%-40s  %-8s  %-8s  %s\n" "Suite" "Passed" "Failed" "Skipped"
  printf "%-40s  %-8s  %-8s  %s\n" "─────────────────────────────────────" "──────" "──────" "───────"

  for f in "$dir"/*.json; do
    [[ -f "$f" ]] || continue
    local suite passed failed skipped
    suite="$(basename "$f" .json)"
    passed=$(node -e "const r=require('$f'); process.stdout.write(String(r.numPassedTests??r.passed??0))" 2>/dev/null || echo 0)
    failed=$(node -e "const r=require('$f'); process.stdout.write(String(r.numFailedTests??r.failed??0))" 2>/dev/null || echo 0)
    skipped=$(node -e "const r=require('$f'); process.stdout.write(String(r.numPendingTests??r.skipped??0))" 2>/dev/null || echo 0)
    printf "%-40s  %-8s  %-8s  %s\n" "$suite" "$passed" "$failed" "$skipped"
  done

  echo ""
  if [[ -f "$dir/typecheck.txt" ]]; then
    local errs
    errs=$(wc -l < "$dir/typecheck.txt" 2>/dev/null || echo 0)
    echo "TypeScript errors: $errs (see test-reports/typecheck.txt)"
  fi
}

cmd_lint() {
  _require_cmds npx
  _section "type-check"
  npm run check-types
  _ok "TypeScript OK"
  _section "eslint"
  npm run lint
  _ok "ESLint OK"
}

# ── interactive menu ──────────────────────────────────────────────────────────

_menu() {
  local ver
  ver=$(_version)
  echo ""
  echo "  Champ VS Code Extension — v${ver}"
  echo ""
  echo "  1) build     — compile + package VSIX"
  echo "  2) install   — install latest GitHub release"
  echo "  3) release   — build + push + create GitHub release"
  echo "  4) watch     — dev watch mode"
  echo "  5) test      — run unit tests"
  echo "  6) test all  — unit + integration tests"
  echo "  7) report    — print test-reports/ summary"
  echo "  8) lint      — type-check + ESLint"
  echo "  9) install build — build current checkout + install"
  echo "  0) version   — print version"
  echo "  q) quit"
  echo ""
  read -rp "  Choice: " pick
  case "$pick" in
    1) cmd_build ;;
    2) cmd_install latest ;;
    3) cmd_release ;;
    4) cmd_watch ;;
    5) cmd_test unit ;;
    6) cmd_test all ;;
    7) cmd_test_report ;;
    8) cmd_lint ;;
    9) cmd_install build ;;
    0) cmd_version ;;
    q|Q) exit 0 ;;
    *) echo "  Unknown choice." >&2 ;;
  esac
}

# ── entrypoint ────────────────────────────────────────────────────────────────

if [[ $# -eq 0 ]]; then
  _menu
  exit 0
fi

case "$1" in
  build)           cmd_build ;;
  install)         shift; cmd_install "${1:-latest}" ;;
  release)         cmd_release ;;
  watch)           cmd_watch ;;
  test)            shift; cmd_test "${1:-unit}" ;;
  lint)            cmd_lint ;;
  version|-v|--version) cmd_version ;;
  help|-h|--help)
    grep '^#   ' "$0" | sed 's/^# //' | head -15
    ;;
  *)
    echo "Unknown command: $1  (run 'scripts/champ help')" >&2
    exit 1
    ;;
esac
